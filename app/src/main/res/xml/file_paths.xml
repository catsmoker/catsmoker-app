<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-path name="external_files" path="." />
    <!-- Log files shared from the Logs screen; pruned to the newest few on every share. -->
    <cache-path name="shared_logs" path="shared/" />
    <!-- The installed base APK copied by the Settings "Share App" card; one file, replaced per share. -->
    <cache-path name="shared_apk" path="shared_apk/" />
    <!-- Legacy session-export directory; the current Logs screen shares diagnostic text only. -->
    <files-path name="session_logs" path="session_logs/" />
</paths>
