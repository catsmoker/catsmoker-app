    <!-- About screen. -->
    <string name="core_about_subtitle">アプリ情報とコミュニティ</string>
    <string name="core_about_description">CatSmokerは、ゲームをより速く、より滑らかに、より応答良く動作させるオープンソースのAndroidツールキットです。</string>
    <string name="about_read_more">続きを読む</string>
    <string name="about_read_less">閉じる</string>
    <string name="about_read_more_body">CatSmokerはシステムリソースを最適化し、ゲームがより高く安定したフレームレートを低い入力遅延で維持できるようにします。一部機能は開発中で、すべてのデバイスで動作するとは限りません。問題が発生した場合は、設定→ヘルプと情報→システムログを開き、GitHubで報告してください。</string>

    <!-- About section labels and rows. -->
    <string name="about_section_contact">開発者と連絡先</string>
    <string name="about_section_links">リンク</string>
    <string name="about_report_issue">問題を報告</string>
    <string name="about_version">バージョン %1$s (%2$d)</string>
