    <!-- Permissions screen. -->
    <string name="core_permissions_title">権限</string>
    <string name="core_permissions_subtitle">すべての機能を有効にするには権限を許可してください。</string>
    <string name="core_perm_root_title">Rootアクセス</string>
    <string name="core_perm_root_sub">高度な最適化に必要です。</string>
    <string name="core_perm_shizuku_title">Shizukuアクセス</string>
    <string name="core_perm_shizuku_sub">Rootの代替としてシステム調整に使用します。</string>
    <string name="core_perm_root_denied">Rootが許可されませんでした。プロンプトまたはRoot管理アプリを確認してください。</string>
    <string name="core_perm_root_unavailable">このデバイスではRootを利用できません。この機能にはRoot済みデバイスが必要です。</string>
    <string name="core_perm_restricted_hint">トグルがオンにならない場合: アプリ情報を開き、三点メニューから「制限付き設定を許可」を選び、戻って再試行してください。</string>
    <string name="core_perm_shizuku_not_running">Shizukuが実行されていません — 先にShizukuアプリで開始してください。</string>
    <string name="core_perm_shizuku_not_granted">Shizukuは実行中です — 許可をタップしてCatSmokerへのアクセスを許可してください。</string>
    <string name="core_perm_storage_title">ストレージアクセス</string>
    <string name="core_perm_storage_sub">ゲーム設定ファイルの読み書きに必要です。</string>
    <string name="core_perm_battery_title">バッテリー最適化</string>
    <string name="core_perm_battery_sub">一般のバッテリー最適化設定を開きます。直接の除外は要求しません。</string>
    <string name="core_perm_notif_title">通知</string>
    <string name="core_perm_notif_sub">サービス状態の表示に必要です。</string>
    <string name="core_perm_overlay_title">オーバーレイ</string>
    <string name="core_perm_overlay_sub">パフォーマンスモニターの表示に必要です。</string>
    <string name="core_perm_usage_title">使用状況アクセス</string>
    <string name="core_perm_usage_sub">任意の同意により、セッション検出や Silent Hunter が前面アプリを監視します。ゲーム以外も強制停止される場合があります。</string>
    <string name="core_perm_mic_title">マイク</string>
    <string name="core_perm_mic_sub">音声ブースト用の任意の出力 Visualizer です。マイク録音ではありません。</string>
    <string name="core_perm_bt_title">Bluetooth</string>
    <string name="core_perm_bt_sub">音声制御のための任意の Bluetooth 音声出力識別です。</string>
