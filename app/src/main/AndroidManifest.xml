<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="ru.zdevs.zarchiver" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <!--
            The games whose install state the File Engineering screen probes with
            PackageManager.getPackageInfo. The blanket MAIN/GAME intent below made them
            visible in practice, but visibility by intent-match is implicit; a stricter
            OEM filter would turn a real installation into a silent NameNotFoundException and
            a false "not installed" dot. Naming the packages makes the probe's world
            explicit:             Genshin + six PUBG variants + New State, GRID, WuWa, five HSR variants.
        -->
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.tencent.igfit" />
        <package android:name="com.pubg.newstate" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.rekoo.pubgm" />
        <package android:name="com.feralinteractive.gridas" />
        <package android:name="com.kurogame.wutheringwaves.global" />
        <package android:name="com.HoYoverse.hkrpgoversea" />
        <package android:name="com.miHoYo.hkrpg" />
        <package android:name="com.HoYoverse.hkrpg" />
        <package android:name="com.cognosphere.hkrpg" />
        <package android:name="com.HoYoverse.hkrpgsamsung" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.GAME" />
        </intent>
    </queries>

    <!--
        Nothing's Glyph Developer Kit AAR declares minSdkVersion 33. This app runs from 27, so
        the library's lower bound must be waived for the merge to pass; GlyphController gates
        every GDK call on SDK_INT >= 34 before a single class is touched, so an older device
        never reaches the code the waiver admits.
    -->
    <uses-sdk tools:overrideLibrary="com.nothing.thirdparty" />

    <!--
        Granted by Nothing's Glyph service to third-party GDK clients (normal protection, no
        dialog). It is what lets GlyphController's proxy bind and drive the LEDs; without it
        register() is refused and the loading bar simply stays unmirrored.
    -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Legacy shared-storage grant, used only on Android 8–10 (API 27–29).
         Android 11+ uses MediaStore/SAF, or all files access in the full build. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!--
        MANAGE_EXTERNAL_STORAGE is deliberately absent here: Play rejected it as
        non-core for this app (2026-10-31). The full build declares it in
        src/full/AndroidManifest.xml; Play uses SAF/MediaStore instead.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- tools:ignore: signature|privileged at install; read via app-ops + Shizuku/root at runtime. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!--
        Never granted at install: it is signature|privileged. It is declared so that the adb grant
        `pm grant com.catsmoker.app android.permission.WRITE_SECURE_SETTINGS` can actually take effect —
        without the declaration that command fails, and the animation-scale and Private DNS cards would
        offer a channel the app could never hold. Root and Shizuku remain the normal paths.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Needed by the overlay boot receiver: without the declaration, BOOT_COMPLETED is never delivered. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- localeConfig is required for Android 13+ per-app locales; safely ignored below API 33 (minSdk 27). -->
    <application
        android:name="com.catsmoker.app.system.CatsmokerApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        tools:replace="android:appComponentFactory"
        tools:targetApi="p"
        tools:ignore="RemoveWorkManagerInitializer,UnusedTranslation"
        android:theme="@style/Theme.Catsmoker">

        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- No persisted legacy SDK flag can initialize Analytics before an explicit choice. -->
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider" tools:node="remove" />

        <!--
            Nothing reads this at registration time. Supplied by a manifest placeholder so the
            real key stays in the git-ignored local.properties; the fallback dummy only makes
            the GDK refuse registration, which turns the feature into a silent no-op.
        -->
        <meta-data
            android:name="NothingKey"
            android:value="${NOTHING_API_KEY}" />

        <activity
            android:name=".system.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager on demand: the default initializer is removed so the HiltWorkerFactory in
            CatsmokerApp constructs @HiltWorker workers. With both present, WorkManager would
            initialize with the default (no-)factory and DexoptSweepWorker would fail to be created.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Scheduled maintenance is ordinary, deferrable work, never specialUse FGS. -->
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />

        <service
            android:name=".screens.gaming.crosshair.CrosshairOverlayService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled aiming overlay visible over a game; stopped by its notification action" />
        </service>

        <service
            android:name=".screens.gaming.performanceoverlay.PerformanceOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled on-screen device performance telemetry with a persistent Stop action" />
        </service>

        <!--
            Restarts the performance overlay after a reboot or an app update, but only when the
            user had it running — the decision comes from a persisted flag the service itself
            writes, not from in-process state that resets on every boot.
        -->
        <receiver
            android:name=".screens.gaming.performanceoverlay.OverlayBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Automatically restores apps suspended by Gaming Mode after a reboot.
            Gaming Mode's `pm suspend` state survives reboots in
            /data/system/package-restrictions.xml. The UI recovery card only runs
            when the user opens the app; this receiver runs at boot so suspended
            apps are woken even if the user never launches CatSmoker.
        -->
        <receiver
            android:name=".screens.gaming.mode.BootRecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".screens.gaming.compilation.AppBoosterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started app compilation progress; cancellable from its notification and ends when compilation ends" />
        </service>

        <!--
            The Stop action on the scheduled dexopt sweep's notification. It cancels the sweep the
            engine is running, not the schedule itself — cancelling the unique work name would take
            the recurring schedule down with the run, which is not what a Stop button promises.
        -->
        <receiver
            android:name=".screens.gaming.compilation.DexoptSweepStopReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".screens.gaming.cleaning.CleanerSweepStopReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".screens.gaming.apps.AutoForceStopService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled foreground-app observation and previous-app force-stop with a persistent Stop action" />
        </service>

        <service
            android:name=".screens.gaming.mode.GamingModeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled gaming configuration session with ongoing status and Stop/restore control" />
        </service>

        <service
            android:name=".screens.gaming.mode.GameSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled foreground game detection and automatic gaming-session management with a persistent Stop action" />
        </service>

        <!--
            Second-layer notification suppression while Gaming Mode is on. BIND_NOTIFICATION_
            LISTENER_SERVICE is enforced by the system, so it is declared on the service rather
            than requested at install: only Android itself may bind here, and only after the
            user grants notification access in Settings. Until that grant this service is inert
            and Gaming Mode reports the layer as not applicable.
        -->
        <service
            android:name=".features.gamingtools.engine.GamingNotificationListener"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            VpnFirewallService is full-only following this app's Play rejection.
            The policy has eligible-use exceptions; this distribution does not
            claim one. Its declaration lives in src/full/AndroidManifest.xml.
        -->

    </application>
</manifest>
